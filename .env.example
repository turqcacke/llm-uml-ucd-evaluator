# Logging
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/llm_uml_evaluator?replicaSet=rs0

# HTTP API
API_SECRET=replace-with-a-nonempty-secret
ENVIRONMENT=DEV
GRAPHVIZ_CONCURRENCY_LIMIT=4

# Supported providers for all components: openai, openrouter.

# Text extraction
EXTRACTOR_MODEL=gpt-5.5
EXTRACTOR_BASE_URL=http://127.0.0.1:8317/v1
EXTRACTOR_API_KEY=your-token-here
EXTRACTOR_PROVIDER=openai  # Omit to let LangChain choose from the model name

# Semantic matching
MATCHER_MODEL=gpt-5.5
MATCHER_BASE_URL=http://127.0.0.1:8317/v1
MATCHER_API_KEY=your-token-here
MATCHER_PROVIDER=openai  # Omit to let LangChain choose from the model name

# Diagram evaluation
EVALUATOR_MODEL=gpt-5.5
EVALUATOR_BASE_URL=http://127.0.0.1:8317/v1
EVALUATOR_API_KEY=your-token-here
EVALUATOR_PROVIDER=openai  # Omit to let LangChain choose from the model name
